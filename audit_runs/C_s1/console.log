[use_visual] does the model need the VGG16 image context?
  [n] no  -- VGG16 is NOT loaded. Decoder only (bbox, velocity, annotations, offline pose/scene/flow).
  [y] yes -- VGG16 context feeds the ConvLSTM encoder. Slow: extracts features for every frame.  <-- default
[feeder] interactive_pick_use_visual <- 'y'
[config] USE_VISUAL = True

--- Architecture ---
  1. pie_convlstm * — PIE paper: ConvLSTM on VGG + single LSTM on bbox/decoder
  2. bbox_only — BBox-only baseline (zero visual features, LSTM on bbox)
  3. pcpa — PCPA-style: visual branch + bbox LSTM + shared extras + attention
  4. branchattn — Branch attention. Sub-menu: static_pool, temporal_concat, or core_plus_extras
  5. branchattn_temporal — Same sub-menu as branchattn. static_pool: temporal attention on every span including bbox. core_plus_extras: temporal attention only on extra spans, not on the core. temporal_concat: no temporal attention.
  6. encoder_extras — Extras tiled into ConvLSTM channels (feature_target=encoder)
  7. both — Extras in both ConvLSTM channels and decoder LSTM
  8. temporal_encoders — PIE decoder + selectable temporal visual encoder (ConvLSTM2D / Transformer / S4 / S4D / Mamba)
  9. decoder_only — use_visual=False. One LSTM on the decoder matrix. No ConvLSTM, no visual_norm, no capacity.
[feeder] interactive_pick_architecture <- '5'
[config] ARCHITECTURE = branchattn_temporal

--- Branch fusion ---
 1. static_pool       * default: Dense(visual) + one LSTM per column + BranchAttnPool [aux + attn log]
 2. temporal_concat   PIE graph, ONE LSTM, no branches [NO aux, NO attn log]
 3. core_plus_extras  PIE core on bbox only; one LSTM per extra column [aux + attn log, needs >=1 extra feature]
[feeder] interactive_pick_branch_mode <- '3'
[config] BRANCH_MODE = core_plus_extras

--- branchattn: temporal block of the VISUAL encoder ---
    Default: the original ConvLSTM2D of this graph (padding valid).
[feeder] choose_branch_temporal_for_menu <- 'n'

--- branchattn: temporal block of each decoder BRANCH ---
    The core LSTM of core_plus_extras always stays an LSTM (control).
[feeder] choose_branch_temporal_for_menu <- 'n'

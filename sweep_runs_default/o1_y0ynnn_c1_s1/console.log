
[offline_features] use the features you processed offline?
  [n] none  -- no disk reads at all (fastest; bbox / velocity / annotation features only)
  [a] all
  [0] pose: YOLO keypoints (extra/pose)
  [1] scene: SegFormer label maps -> 24-d scene vector (extra/scene)
  [2] flow: optical flow summaries (extra/flow)
  Enter comma-separated indices (e.g. 0,2), 'a' or 'n'. [default: all]
[feeder] interactive_pick_offline_features <- '1'
[config] OFFLINE_FEATURES = ['scene']

[use_visual] does the model need the VGG16 image context?
  [n] no  -- VGG16 is NOT loaded. Decoder only (bbox, velocity, annotations, offline pose/scene/flow).
  [y] yes -- VGG16 context feeds the ConvLSTM encoder. Slow: extracts features for every frame.  <-- default
[feeder] interactive_pick_use_visual <- 'y'
[config] USE_VISUAL = True

[bbox_mode] decoder bbox columns:
  [0] normal: bbox used as selected  <-- default
  [1] zero: bbox columns = 0 (visual-only diagnostic; bbox_branch is zeroed too)
      note: the VGG crop is still cut around the person, so it still encodes position and size
[feeder] interactive_pick_zero_decoder_bbox <- '0'
[config] ZERO_DECODER_BBOX = False

[visual_norm] standardize VGG16 conv5 maps per channel before the ConvLSTM?
  [n] no  -- raw VGG16 activations, as cached  <-- default
  [y] yes -- (x - mean_train) / std_train per channel; statistics from TRAIN only
[feeder] interactive_pick_visual_norm <- 'y'
[config] VISUAL_NORM = True
[feeder] visual_percentile <- 'n'
[config] USE_PERCENTILE = False

[capacity] presets for the visual branch (every choice except the baseline deviates from the paper):
  [0] baseline (paper design)  <-- default
  [1] A: 1x1 bottleneck after ConvLSTM (64 -> 8)
  [2] B: 1x1 input projection (512 -> 64)
  [3] A+B
  [4] A+B with decoder hidden units 64
  [5] custom (asked step by step)
[feeder] interactive_pick_capacity <- '1'
[feeder] interactive_pick_capacity <- 'n'
[feeder] interactive_pick_capacity <- 'n'

[capacity] parameter budget (visual branch + decoder):
  ConvLSTM2D 512 -> 64, kernel 2, valid                    590,080
  encoder 1x1 conv 64 -> 8                                     520
  decoder LSTM in=292 (flat 288 + bbox 4), units=128       215,552
  decoder Dense 128 -> 1                                       129
  ----------------------------------------------------------------
  TOTAL                                                    806,281
  share of baseline                                          43.9%
[capacity] decoder LSTM input width = 292
[capacity] note: the 512-channel ConvLSTM input kernel (~590k) still dominates the encoder. Add B to test the input projection separately.
[capacity] reminder: any reduction deviates from the paper. Report it as an ablation and compare with a parameter-matched bbox-only control.
[config] CAPACITY = {'convlstm_filters': 64, 'log1p': False, 'encoder_reduce': 8, 'input_reduce': 0, 'hidden_units': 128, 'return_sequences': False}

[visual_pipeline] experiment B: VGG -> Standardize -> ConvLSTM

[log_mode] choose console verbosity for this run:
  [0] clean  (phase explanations + meaningful metrics only (recommended))  <-- default
  [1] full  (everything, including raw config dumps (original behavior))
[feeder] interactive_pick_log_mode <- '0'
[config] LOG_MODE = clean

[balance_mode] existing balancing strategies:
  [0] augmentation  (custom method -- geometric + photometric + temporal (shift/speed/occlusion) + micro-jitter)  <-- default
  [1] undersample_base_article  (PIEPredict-style undersampling (not verified identical to the reference code))
  [2] none  (no balancing -- raw imbalanced train/val (use with weighted_bce/focal_loss))
[feeder] interactive_pick_balance_mode <- '1'
[config] BALANCE_MODE = undersample_base_article

[monitor_metric] choose what EarlyStopping/Checkpoint/Plateau monitor:
  [0] val_nll (min)  -- validation NLL, data term only (no L2)  <-- default
  [1] val_auc (max)  -- validation ROC-AUC
  [2] val_loss (min)  -- validation loss incl. L2 (not a generalization metric)
[feeder] interactive_pick_monitor_metric <- '2'
[config] MONITOR_METRIC = val_loss (mode=min)

[loss_function] choose the training loss function:
  [0] binary_crossentropy  (standard BCE loss)  <-- default
  [1] focal_loss           (focal loss for class imbalance)
  [2] weighted_bce         (pos_weight computed AUTOMATICALLY from the train split's real class counts, after balancing/augmentation is applied)
  [3] composite            (CE + optional focal / smoothing / confidence / ranking)
  [4] bce_plus_focal       (BCE + weight * focal, summed)
[feeder] interactive_pick_loss_choice <- '0'
[config] LOSS_FUNCTION (family) = binary_crossentropy

[weight_decay] RMSprop weight_decay in TF 2.10.1 / Keras 2.10.0:
  NOT SUPPORTED. Keras 2.10.0's RMSprop has no 'weight_decay' argument -- any non-zero value crashes at optimizer construction.
  L2 regularization in this project comes from REGULARIZER_VAL (kernel/recurrent/bias regularizers), which is unaffected by this.
[feeder] interactive_pick_weight_decay <- ''
[weight_decay] weight_decay = 0.0
[config] WEIGHT_DECAY = 0.0

[lstm_recurrent_activation]
  1) sigmoid       (current code default)
  2) hard_sigmoid  (official model.h5)
[feeder] interactive_pick_lstm_recurrent_activation <- '2'

[normalize_bbox] decoder bbox representation:
  [0] raw pixels (x1, y1, x2, y2). Same as earlier runs; large values saturate the gates
  [1] centre-x/W, ground-y/H, log(h/H)/5, log(w/W)/5. Keeps size and ground-position cues
  (default: [1])
[feeder] interactive_pick_normalize_bbox <- '0'
[config] normalize_decoder_bbox = False
[feeder] plateau <- 'y'
[config] LSTM_REC_ACT=hard_sigmoid NORM_BBOX=False USE_PLATEAU=True

